[Desktop Entry]
Type=Application
Name=Desktop Rug - Enable
Name[fa]=فعال‌سازی فرش دسکتاپ
Comment=Start Desktop Rug now and at every login
Exec=sh -c 'for d in "$(dirname "$1")" "$PWD" "$HOME/.local/share/desktop-rug"; do [ -f "$d/enable-desktop-rug.sh" ] && exec sh "$d/enable-desktop-rug.sh"; done; f=$(find "$HOME" -maxdepth 4 -name enable-desktop-rug.sh 2>/dev/null | head -n 1); [ -n "$f" ] && exec sh "$f"; notify-send "Desktop Rug" "enable-desktop-rug.sh not found"' sh %k
Icon=preferences-desktop-wallpaper
Terminal=false
